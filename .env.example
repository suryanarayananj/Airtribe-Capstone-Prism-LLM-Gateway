# Gateway
PRISM_PORT=8080
PRISM_HOST=0.0.0.0

# Path to SQLite file (default: data/prism.db under project root)
# PRISM_DB_PATH=data/prism.db

# Upstream mode: mock (pack scripts/mock_provider.py) or openrouter
PRISM_UPSTREAM=mock

# Mock provider URLs (override if Windows blocks 9001/9002 — do not edit pack sample JSON)
# PRISM_ALPHA_BASE_URL=http://127.0.0.1:18001/v1
# PRISM_BETA_BASE_URL=http://127.0.0.1:18002/v1
# PRISM_ALPHA_API_KEY=mock-key-alpha
# PRISM_BETA_API_KEY=mock-key-beta
# PRISM_UPSTREAM_TIMEOUT_MS=1000
# How healthy providers are ordered: failover | least_latency | weighted
# PRISM_ROUTING_STRATEGY=failover
# Default cache entry lifetime in seconds (24h). Per-key cache_ttl_seconds overrides this.
# PRISM_CACHE_TTL_SECONDS=86400

# Optional OpenRouter (demo/test). Adapter maps Prism slots onto these ids.
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# PRISM_OPENROUTER_ALPHA_SMALL=openai/gpt-4o-mini
# PRISM_OPENROUTER_BETA_SMALL=google/gemini-2.0-flash-001
# PRISM_OPENROUTER_ALPHA_LARGE=google/gemini-2.0-flash-001
# PRISM_OPENROUTER_BETA_LARGE=openai/gpt-4o-mini

# Admin demo token (Phase 6)
PRISM_ADMIN_TOKEN=prism-admin-demo
